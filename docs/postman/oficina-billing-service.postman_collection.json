    {
      "name": "Decisão do cliente (saga)",
      "description": "Precisa de `orcamentoSagaId`: orçamento gerado pelo comando GerarOrcamento da saga. Sem ele, os requests são pulados.",
      "item": [
        {
          "name": "Decidir orçamento da saga (202)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Precisa de um orçamento gerado pela saga (comando GerarOrcamento).",
                  "// Pegue o orcamentoId em GET /api/ordens-servico/{id} do OS Service.",
                  "if (!pm.variables.get('orcamentoSagaId')) {",
                  "    console.log('orcamentoSagaId vazio: request pulado');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) {",
                  "    pm.collectionVariables.set('decisaoId', pm.response.json().decisaoId);",
                  "}",
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "pm.test('status do orçamento segue a decisão', () => {",
                  "    const esperado = pm.variables.get('decisao') === 'aprovar' ? 'aprovado' : 'recusado';",
                  "    pm.expect(pm.response.json().status).to.eql(esperado);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orcamentos/{{orcamentoSagaId}}/decisao",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decisao\": \"{{decisao}}\",\n  \"motivo\": \"Valor acima do esperado\"\n}"
            },
            "description": "Publica orcamento.aprovado ou orcamento.recusado pelo outbox. `motivo` só vai na recusa (na aprovação é descartado)."
          }
        },
        {
          "name": "Repetir a decisão (409 ja_decidido)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Precisa de um orçamento gerado pela saga (comando GerarOrcamento).",
                  "// Pegue o orcamentoId em GET /api/ordens-servico/{id} do OS Service.",
                  "if (!pm.variables.get('orcamentoSagaId')) {",
                  "    console.log('orcamentoSagaId vazio: request pulado');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('ja_decidido com o decisaoId original', () => {",
                  "    const c = pm.response.json();",
                  "    pm.expect(c.motivo).to.eql('ja_decidido');",
                  "    pm.expect(c.decisaoId).to.eql(pm.collectionVariables.get('decisaoId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orcamentos/{{orcamentoSagaId}}/decisao",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decisao\": \"{{decisao}}\"\n}"
            },
            "description": "A repetição não publica outro evento; republica o da primeira decisão se ele tiver ficado pendente no outbox."
          }
        },
        {
          "name": "Consultar orçamento da saga",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Precisa de um orçamento gerado pela saga (comando GerarOrcamento).",
                  "// Pegue o orcamentoId em GET /api/ordens-servico/{id} do OS Service.",
                  "if (!pm.variables.get('orcamentoSagaId')) {",
                  "    console.log('orcamentoSagaId vazio: request pulado');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
